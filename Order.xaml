<UserControl x:Class="CarMarket.Order"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarMarket"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Background="White" Grid.ColumnSpan="2"></Border>

        <Button x:Name="Back" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Click="Back_Click" Grid.Column="1">Назад</Button>

        <Border Background="#eef1f5" CornerRadius="15" Margin="20" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" BlurRadius="20" ShadowDepth="0" Direction="0"/>
            </Border.Effect>
            <StackPanel Margin="15">
                <TextBlock  Margin="0,0,0,25" FontFamily="Century Gothic" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center">Автомобиль</TextBlock>
                <TextBlock x:Name="Mark" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Марка: </TextBlock>
                <TextBlock x:Name="Model" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Модель: </TextBlock>
                <TextBlock x:Name="Year" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Год: </TextBlock>
                <TextBlock x:Name="Fuel" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Тип топлива: </TextBlock>
                <TextBlock x:Name="Transmission" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">КПП: </TextBlock>
                <TextBlock x:Name="Engine" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Двигатель: </TextBlock>
                <TextBlock x:Name="Power" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">Мощность: </TextBlock>
                <Button Content="Купить" Margin="0,15,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="18" Style="{StaticResource MaterialDesignFlatDarkBgButton}" FontFamily="Century Gothic" FontWeight="Bold"/>
            </StackPanel>
        </Border>
        <Image x:Name="ImageCar" Grid.Column="1">
         
        </Image>
        <TextBlock x:Name="Price" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30" FontWeight="Bold" FontSize="32" FontFamily="Arial Black">1000000 руб</TextBlock>
    </Grid>
</UserControl>
