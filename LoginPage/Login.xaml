<Window x:Class="CarMarket.LoginPage.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarMarket.LoginPage"
        mc:Ignorable="d"
        Title="Вход" Height="650" Background="#e4ecfd" Width="600" Closing="Window_Closing">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <Border Background="White" VerticalAlignment="Top" Margin="15" Padding="40" CornerRadius="15" MaxWidth="400">
            <StackPanel>
                <TextBlock Text="Буханка.ру" Margin="0,0,0,30"  FontSize="28" FontWeight="Bold" TextWrapping="WrapWithOverflow" Foreground="#FFEE3F58" FontFamily="Century Gothic" HorizontalAlignment="Center"/>
                
                <Border Background="#f5f7fa" CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="LoginBox" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Логин" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"></TextBox>
                </Border>

                <Border Background="#f5f7fa" CornerRadius="5" Margin="0,0,0,15">
                    <PasswordBox Name="PasswordBox" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" FontFamily="Century Gothic" FontSize="20"></PasswordBox>
                </Border>

            
                <Button x:Name="LoginButton" Content="Войти" MinHeight="50" materialDesign:ButtonAssist.CornerRadius="5" Margin="0,30,0,0" FontSize="18" Style="{StaticResource MaterialDesignFlatDarkBgButton}" FontFamily="Century Gothic" FontWeight="Bold" BorderBrush="#FF1D5DEB" Background="#FF1D5DEB" Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
            <TextBlock x:Name="Registration" Text="Зарегистрироваться" Foreground="#FF1D5DEB" HorizontalAlignment="Center" FontFamily="Century Gothic" FontSize="18" MouseDown="Registration_MouseDown"/>
        </StackPanel>
        <Frame x:Name="NavigationFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
