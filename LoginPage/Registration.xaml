<UserControl x:Class="CarMarket.LoginPage.Registration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CarMarket.LoginPage"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600">
    <Grid>
        <Border Background="#e4ecfd"/>
        <StackPanel VerticalAlignment="Center">
            <Border Background="White" VerticalAlignment="Top" Margin="15" Padding="40" CornerRadius="15" MaxWidth="400">
                <StackPanel>
                    <TextBlock Text="Буханка.ру" Margin="0,0,0,30"  FontSize="28" FontWeight="Bold" TextWrapping="WrapWithOverflow" Foreground="#FFEE3F58" FontFamily="Century Gothic" HorizontalAlignment="Center"/>

                    <Border Background="#f5f7fa" CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="Login" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Логин" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"></TextBox>
                    </Border>

                    <Border Background="#f5f7fa"  CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="Password" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"/>
                    </Border>
                    <Border Background="#f5f7fa"  CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="LastName" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Фамилия" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"/>
                    </Border>

                    <Border Background="#f5f7fa"  CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="FirstName" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Имя" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"/>
                    </Border>

                    <Border Background="#f5f7fa"  CornerRadius="5" Margin="0,0,0,15">
                        <TextBox x:Name="Phone" Margin="0,5,0,0" materialDesign:HintAssist.Hint="Номер телефона" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontFamily="Century Gothic" FontSize="20"/>
                    </Border>
                    <Button x:Name="RegistrationButton" Content="Продолжить" MinHeight="50" materialDesign:ButtonAssist.CornerRadius="5" Margin="0,30,0,0" FontSize="18" Style="{StaticResource MaterialDesignFlatDarkBgButton}" FontFamily="Century Gothic" FontWeight="Bold" BorderBrush="#FF1D5DEB" Background="#FF1D5DEB" Click="RegistrationButton_Click"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="LoginButton" Text="Уже зарегистрировались? Войти" Foreground="#FF1D5DEB" HorizontalAlignment="Center" FontFamily="Century Gothic" FontSize="18" MouseDown="Login_MouseDown"/>
        </StackPanel>
    </Grid>
</UserControl>
