<UserControl x:Class="CarMarket.Deal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarMarket"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="#eef1f5" Grid.ColumnSpan="2"></Border>
        <Button x:Name="Back" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Click="Back_Click" Grid.Column="1">Назад</Button>

        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="15">
            <TextBlock Text="Список сделок" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0" FontFamily="Century Gothic" FontWeight="Bold" FontSize="28" TextAlignment="Center"/>
            <TextBox x:Name="Value" materialDesign:HintAssist.Hint="Поиск" VerticalAlignment="Top" MinWidth="150" FontFamily="Century Gothic" FontSize="18" TextChanged="Value_TextChanged"></TextBox>
            <ComboBox x:Name="Filter" materialDesign:HintAssist.Hint="Фильтр" Margin="15,0,15,0" VerticalAlignment="Top" MinWidth="200" FontFamily="Century Gothic" FontSize="18" SelectionChanged="Filter_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="dataGrid" Margin="0,65,0,0" ColumnWidth="*" AutoGenerateColumns="False" IsReadOnly="True" Background="#FFEEF1F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding deal_id}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="1*"/>
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding car}" Width="1*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price}" Width="1*"/>
                <DataGridTextColumn Header="Подписан" Binding="{Binding date_start, StringFormat='dd.MM.yyyy'}" Width="1*"/>
                <DataGridTextColumn Header="Исполнен" Binding="{Binding date_end, StringFormat='dd.MM.yyyy'}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
