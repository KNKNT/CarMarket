<UserControl x:Class="CarMarket.MakeOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarMarket"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Background="White" Grid.ColumnSpan="2"></Border>

        <Button x:Name="Back" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Click="Back_Click" Grid.Column="1">Назад</Button>

        <Border Background="#eef1f5" CornerRadius="15" Margin="20" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" BlurRadius="20" ShadowDepth="0" Direction="0"/>
            </Border.Effect>
            <StackPanel Margin="15">
                <TextBlock  Margin="0,0,0,25" FontFamily="Century Gothic" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center">Автомобиль</TextBlock>
                <ComboBox x:Name="Mark" materialDesign:HintAssist.Hint="Марка" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20"></ComboBox>
                <TextBox x:Name="Model" materialDesign:HintAssist.Hint="Модель" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20"></TextBox>
                <TextBox x:Name="Year" MaxLines="4" materialDesign:HintAssist.Hint="Год" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20"></TextBox>
                <ComboBox x:Name="Fuel" materialDesign:HintAssist.Hint="Тип топлива" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">
                    <ComboBoxItem>Бензин</ComboBoxItem>
                    <ComboBoxItem>Дизель</ComboBoxItem>
                    <ComboBoxItem>Электричество</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="Transmission" materialDesign:HintAssist.Hint="КПП" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20">
                    <ComboBoxItem>Автомат</ComboBoxItem>
                    <ComboBoxItem>Механика</ComboBoxItem>
                    <ComboBoxItem>Робот</ComboBoxItem>
                </ComboBox>
                <TextBox x:Name="Engine" materialDesign:HintAssist.Hint="Двигатель" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20"></TextBox>
                <TextBox x:Name="Power" materialDesign:HintAssist.Hint="Мощность" Margin="0,0,0,15" FontFamily="Century Gothic" FontSize="20"></TextBox>
            </StackPanel>
        </Border>
        <Image x:Name="ImageCar" Grid.Column="1">

        </Image>
        <TextBox x:Name="Price" MaxLength="10" materialDesign:HintAssist.Hint="Цена" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" FontWeight="Bold" FontSize="32" FontFamily="Arial Black"></TextBox>
        <TextBox x:Name="Image" MaxWidth="180" materialDesign:HintAssist.Hint="Ссылка на изображение" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="16" FontFamily="Centry Ghotic" TextChanged="Image_TextChanged"/>
        <Button x:Name="Add" Style="{StaticResource MaterialDesignFlatDarkBgButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Grid.Column="1" Click="Add_Click">Продолжить</Button>

    </Grid>
</UserControl>
